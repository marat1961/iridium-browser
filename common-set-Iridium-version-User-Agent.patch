From 8e3230a5cce59367721a755b20bce35fe22b9a81 Mon Sep 17 00:00:00 2001
From: Jan Engelhardt <jengelh@inai.de>
Date: Wed, 8 Jul 2015 15:08:32 +0200
Subject: [PATCH 76/79] common: set Iridium version / User-Agent

---
 chrome/VERSION                                            | 8 ++++----
 components/version_info/version_info.cc                   | 6 +++++-
 components/version_info/version_info_values.h.version     | 2 +-
 content/common/user_agent.cc                              | 2 ++
 extensions/shell/common/version.h.in                      | 2 +-
 tools/metrics/histograms/extract_histograms.py            | 2 +-
 .../histograms/generate_expired_histograms_array.py       | 4 ++--
 7 files changed, 16 insertions(+), 10 deletions(-)

diff --git chrome/VERSION chrome/VERSION
index 2fa16103fedf..96d3118c2791 100644
--- chrome/VERSION
+++ chrome/VERSION
@@ -1,4 +1,4 @@
-MAJOR=88
-MINOR=0
-BUILD=4324
-PATCH=182
+MAJOR=2021
+MINOR=03
+BUILD=88
+PATCH=0
diff --git components/version_info/version_info.cc components/version_info/version_info.cc
index 807c8996e0f5..7287e5915827 100644
--- components/version_info/version_info.cc
+++ components/version_info/version_info.cc
@@ -17,7 +17,11 @@
 namespace version_info {
 
 std::string GetProductNameAndVersionForUserAgent() {
-  return "Chrome/" + GetVersionNumber();
+	/*
+	 * Currently, the Iridium install base is arguably small enough that it
+	 * would users rather identifiable if the UA was changed.
+	 */
+	return "Chrome/88.0.4324.182";
 }
 
 std::string GetProductName() {
diff --git components/version_info/version_info_values.h.version components/version_info/version_info_values.h.version
index 6232e359ef20..3cf4fee096c0 100644
--- components/version_info/version_info_values.h.version
+++ components/version_info/version_info_values.h.version
@@ -6,7 +6,7 @@
 #define COMPONENTS_VERSION_INFO_VERSION_INFO_VALUES_H_
 
 #define PRODUCT_NAME "@PRODUCT_FULLNAME@"
-#define PRODUCT_VERSION "@MAJOR@.@MINOR@.@BUILD@.@PATCH@"
+#define PRODUCT_VERSION "@MAJOR@.@MINOR@"
 #define LAST_CHANGE "@LASTCHANGE@"
 #define IS_OFFICIAL_BUILD @OFFICIAL_BUILD@
 
diff --git content/common/user_agent.cc content/common/user_agent.cc
index 8315350e3f66..a89724683267 100644
--- content/common/user_agent.cc
+++ content/common/user_agent.cc
@@ -305,6 +305,8 @@ std::string BuildUserAgentFromOSAndProduct(const std::string& os_info,
       product.c_str(),
       WEBKIT_VERSION_MAJOR,
       WEBKIT_VERSION_MINOR);
+  if (strncmp(product.c_str(), "Chrome/", 7) != 0)
+	base::StringAppendF(&user_agent, " Chrome/81.0.4044.92");
   return user_agent;
 }
 
diff --git extensions/shell/common/version.h.in extensions/shell/common/version.h.in
index c4627fe512a1..bf7d27484e99 100644
--- extensions/shell/common/version.h.in
+++ extensions/shell/common/version.h.in
@@ -7,7 +7,7 @@
 #ifndef EXTENSIONS_SHELL_COMMON_VERSION_H_
 #define EXTENSIONS_SHELL_COMMON_VERSION_H_
 
-#define PRODUCT_VERSION "@MAJOR@.@MINOR@.@BUILD@.@PATCH@"
+#define PRODUCT_VERSION "@MAJOR@.@MINOR@"
 #define LAST_CHANGE "@LASTCHANGE@"
 
 #endif  // EXTENSIONS_SHELL_COMMON_VERSION_H_
diff --git tools/metrics/histograms/extract_histograms.py tools/metrics/histograms/extract_histograms.py
index 6245b16e3d69..360d190b0f68 100644
--- tools/metrics/histograms/extract_histograms.py
+++ tools/metrics/histograms/extract_histograms.py
@@ -81,7 +81,7 @@ DEFAULT_BASE_HISTOGRAM_OBSOLETE_REASON = (
     'Base histogram. Use suffixes of this histogram instead.')
 
 EXPIRY_DATE_PATTERN = "%Y-%m-%d"
-EXPIRY_MILESTONE_RE = re.compile(r'M[0-9]{2,3}\Z')
+EXPIRY_MILESTONE_RE = re.compile(r'M[0-9]{2,4}\Z')
 
 
 _ELEMENT_NODE = xml.dom.minidom.Node.ELEMENT_NODE
diff --git tools/metrics/histograms/generate_expired_histograms_array.py tools/metrics/histograms/generate_expired_histograms_array.py
index baae46042943..cbaad7fc1474 100755
--- tools/metrics/histograms/generate_expired_histograms_array.py
+++ tools/metrics/histograms/generate_expired_histograms_array.py
@@ -16,8 +16,8 @@ import merge_xml
 import histogram_paths
 
 _DATE_FILE_RE = re.compile(r".*MAJOR_BRANCH_DATE=(.+).*")
-_CURRENT_MILESTONE_RE = re.compile(r"MAJOR=([0-9]{2,3})\n")
-_MILESTONE_EXPIRY_RE = re.compile(r"\AM([0-9]{2,3})")
+_CURRENT_MILESTONE_RE = re.compile(r"MAJOR=([0-9]{2,4})\n")
+_MILESTONE_EXPIRY_RE = re.compile(r"\AM([0-9]{2,4})")
 
 _SCRIPT_NAME = "generate_expired_histograms_array.py"
 _HASH_DATATYPE = "uint64_t"
-- 
2.30.1

