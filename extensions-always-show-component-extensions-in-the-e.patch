From 92000e50b1857ff30c02e3e69898db1718b52d0e Mon Sep 17 00:00:00 2001
From: Jan Engelhardt <jengelh@inai.de>
Date: Thu, 25 Jun 2015 15:34:10 +0200
Subject: [PATCH 69/79] extensions: always show component extensions in the ext
 list

The attached patch makes sure that component extensions are always
shown in "chrome://extensions".

Currently these are
- Bookmark Manager
- Chromium PDF Viewer
- CryptoTokenExtension

References: https://github.com/iridium-browser/iridium-browser/issues/28
---
 extensions/common/extension.cc | 3 +++
 1 file changed, 3 insertions(+)

diff --git extensions/common/extension.cc extensions/common/extension.cc
index b0b72345c02e..0dfb65ec09ae 100644
--- extensions/common/extension.cc
+++ extensions/common/extension.cc
@@ -378,9 +378,12 @@ bool Extension::ShouldDisplayInNewTabPage() const {
 }
 
 bool Extension::ShouldExposeViaManagementAPI() const {
+#if 0
   // Hide component extensions because they are only extensions as an
   // implementation detail of Chrome.
   return !extensions::Manifest::IsComponentLocation(location());
+#endif
+  return false;
 }
 
 Extension::ManifestData* Extension::GetManifestData(const std::string& key)
-- 
2.30.1

