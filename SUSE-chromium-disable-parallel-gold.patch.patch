From 5148ad6ff001dcf8dff2fec26ad4e2f8813171a6 Mon Sep 17 00:00:00 2001
From: Jan Engelhardt <jengelh@inai.de>
Date: Wed, 18 Nov 2020 12:29:01 +0100
Subject: [PATCH 13/73] SUSE chromium-disable-parallel-gold.patch

---
 build/config/compiler/BUILD.gn | 2 --
 1 file changed, 2 deletions(-)

diff --git build/config/compiler/BUILD.gn build/config/compiler/BUILD.gn
index 72ea590d69681..e56f5593fd772 100644
--- build/config/compiler/BUILD.gn
+++ build/config/compiler/BUILD.gn
@@ -461,8 +461,6 @@ config("compiler") {
         # https://groups.google.com/a/chromium.org/group/chromium-dev/browse_thread/thread/281527606915bb36
         # Only apply this to the target linker, since the host
         # linker might not be gold, but isn't used much anyway.
-        "-Wl,--threads",
-        "-Wl,--thread-count=4",
       ]
     }
 
